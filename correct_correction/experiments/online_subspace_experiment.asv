clear all
rng(2024);

% matrix size
n = 400;
dim = n;
% randomly generate eigenvlaues, eigenvectors recover matrix
% [A_org, evals, evecs] = rand_mat_real(n);
[A_org, evals, evecs] = case1(n);



% n = 100;
% 
% k=-1;
% R = normrnd(0,1,n,n);
% [U,~] = qr(R,'econ');
% 
% Sigma = diag([1.00001 logspace(0,k,n-1)]);
% eig_A = diag(Sigma);
% A_org = U*Sigma*U';
% evecs = U; evals = diag(Sigma);

% initial state: a certain combination of the eigen-vectors
x0 = evecs * ones(n, 1);

% steps for the simulation snapshots
steps = 201;

% simulate snapshots observation
data = zeros([n, steps]);
data(:, 1) = x0;
for i = 2:steps
    data(:, i) = A_org * data(:, i-1);
end

% best for ref
r = 10; 
% X = data(:, 1:end-1); Y = data(:, 2:end);
% A = Y * pinv(X);

A = A_org;
[V, D] = main_eig(A, r);

% init for online subspace iteration (not practical, just for reference)
init = 2*r;
Dt = data(:, 1:init);
X = Dt(:, 1:end-1);
Y = Dt(:, 2:end);
[V_on, D_on, Q_on] = simple_dmd(X, Y, r);
V_ons = V_on; D_ons = D_on; Q_ons = Q_on;
B_ons = pinv(X) * Q_ons;

% current sota
[V_sota, D_sota] = direct_solve(X, Y, r);

% dmd
[V_dmd, D_dmd, Q_dmd] = simple_dmd(X, Y, r);

err_vec_on = vecs_distance(V_on, V);
err_val_on = vals_distance(D_on, D);

err_vec_onsub = err_vec_on;
err_val_onsub = err_val_on;

err_vec_sota = vecs_distance(V_sota, V);
err_val_sota = vals_distance(D_sota, D);

err_vec_dmd = vecs_distance(V_dmd, V);
err_val_dmd = vals_distance(D_dmd, D);

rate = 1;
vr = Q_on' * V_on;
B = pinv(Dt) * Q_on;
% P == Dt*B, U == P*UR == Dt*B*UR

B_ons = B;

eval_on = [];   eval_ons = [];   eval_sota = [];
% online iteration
for i = 1: steps-init
    % data preparation
    Dt = data(:, 1:init+i);
    D_old = Dt(:, 1:end-1);
    D_new = Dt(:, 2:end);
    % A * D_old == D_new

    % alg: online
    err_subspace(i) = cond(V_ons);
    % err_subspace(i) = norm(Q_on - Q_ons, 'fro');
    % preparation
    % A_r = Q_on' * D_new * pinv(D_old) * Q_on;
    A_r = Q_on' * D_new * B;
    r1 = A_r;
    % N = Q_on' * D_old; A_r = Q_on' * D_new * pinv(N);

    [vr, D_on] = main_eig(A_r, r);
    V_on = Q_on*vr;
    err_vcond(i) = cond(V_ons);

    Uinv = vr \ Q_on';
    new_BU = [B; zeros(1, r)];
    for j = 1:r

        temp1 = B * vr(:, j) / D_on(j);
        term1 = [0; temp1];
        
        lambda_minus = diag(D_on(j) - D_on);
        temp2 = B * vr * pinv(lambda_minus) * Uinv * D_new * B * vr(:, j);
        term2 = [temp2; 0];

        new_BU(:, j) = term1 + term2;   % dU == Dt*(new_BU-BU)
    end

    %%% route 1, closed-form
    % BU = [BU; zeros(1, r)]; % U == D_old*BU ---> U == Dt*BU
    % delta_BU = new_BU - BU; % dU == Dt*delta_BU
    % B_ex = [B; zeros(1, r)]; % P == D_old*B ---> P == Dt*B_ex
    % 
    % new_B = delta_BU / vr + B_ex; % new_P == dP + P == Dt*new_B
    % new_P = Dt * new_B;
    % err1(i) = norm(new_P - Dt * pinv(Dt) * new_P, 'fro');

    % B1 = new_B * Rinv;     % closed-form parameter
    % B2 = pinv(Dt) * Q_on;  % directly calculated (not practical) parameter
    % B = B1;
    % % [P, R] = qr(new_P, 'econ'); Rinv = inv(R);
    % % [P, s, v] = svd(new_P, 'econ'); Rinv = v * pinv(s);
    % [Q_on, R] = qr(new_P, 'econ'); Rinv = inv(R);

    %%% route 2, directly adding up
    new_U = Dt * new_BU;
    [Q_on, R] = qr(new_U, 'econ'); % Q_on = Dt * new_BU / R
    B = new_BU / R;

    err_rcond(i) = cond(R);
    err_qcond(i) = cond(Q_on);
    err_vrcond(i) = cond(vr);
    err_dt(i) = cond(Dt);
    % [Q_on, R, T] = qr(new_P, 'econ'); Rinv = T / R;   % Q_on = new_P * Rinv

    % record error
    % err(i) = norm(Dt*(B1 - B2), 'fro');    % why???????????????????????
    % err_ana(i) = norm(Q_on - Dt*B1, 'fro');
    % err_ref(i) = norm(Q_on - Dt*B2, 'fro');   % why???????????????????????
    % err_qr(i) = norm(Q_on - new_P * Rinv, 'fro');

    % online subspace - reference version. (directly!)
    B_ons = pinv(D_old)*Q_ons;
    % At = A_org;
    At = D_new * pinv(D_old);
    A_r = Q_ons' * At * Q_ons;
    % A_r = Q_ons' * D_new * B_ons;

    err_tilde_a(i) = norm(r1 - A_r, 'fro');

    [vr, D_ons] = main_eig(A_r, r);
    V_ons = Q_ons * vr;

    % [u0, s0, v0] = svd(Dt);
    % % Now, V_ons should be in the span(D_old). is it?
    % err_span1(i) = norm(V_ons - u0 * u0' * V_ons, 'fro');
    
    for j = 1:r
        u = V_ons(:, j);

        % Q_ons == D_old * B_ons, u == D_old * B_ons * vr(:, j)
        % ======
        term1 = D_new * B_ons * vr(:, j) / D_ons(j);
        lambda_minus = diag(D_ons(j) - D_ons);
        term2 = V_ons * pinv(lambda_minus) / vr * Q_ons' * D_new * B_ons * vr(:, j);

        new_u(:, j) = term1 + term2;
    end

    [Q_ons, ~] = qr(new_u, 'econ');

    % % Now, P and Q_ons should be in the span(Dt). is it?
    % err_span3(i) = norm(P - Dt * pinv(Dt) * P, 'fro');
    % err_span4(i) = norm(Q_ons - Dt * pinv(Dt) * Q_ons, 'fro');

    err_vec_onsub = [err_vec_onsub, vecs_distance(V_ons, V)];
    err_val_onsub = [err_val_onsub, vals_distance(D_ons, D)];

    % is pinv(Dt) * Dt still almost identity?
    err_norm_i(i) = norm(pinv(Dt) * Dt - eye(init+i), 'fro');

    % the condition number of Dt is related!
    cond_dt(i) = cond(Dt);

    % save methods error===================================================

    err_vec_on = [err_vec_on, vecs_distance(V_on, V)];
    err_val_on = [err_val_on, vals_distance(D_on, D)];

    % other 2 ref
    % current sota
    Xt = D_old; Yt = D_new;
    [V_sota, D_sota] = direct_solve(Xt, Yt, r);
    
    % dmd
    [V_dmd, D_dmd, Q_dmd] = simple_dmd(Xt, Yt, r);
    
    err_vec_sota = [err_vec_sota, vecs_distance(V_sota, V)];
    err_val_sota = [err_val_sota, vals_distance(D_sota, D)];
    
    err_vec_dmd = [err_vec_dmd, vecs_distance(V_dmd, V)];
    err_val_dmd = [err_val_dmd, vals_distance(D_dmd, D)];

    i

    eval_on = [eval_on, D_on];
    eval_ons = [eval_ons, D_ons];
    eval_sota = [eval_sota, D_sota];
end

% figure()
% plot(err_ons)
% yscale log
% 
% 
% figure()
% hold on
% plot(err_span1)
% plot(err_span2)
% plot(err_span3)
% plot(err_span4)
% yscale log
% legend()

figure('Position', [100, 100, 1200, 600])
sgtitle('Eigenvalue prediction of online algorithm')
timeline = 1: steps-init;
for i = 1:9
    subplot(3,3,i)
    hold on
    plot(abs(eval_on(i, :) - D(i)))
    plot(abs(eval_ons(i, :) - D(i)))
    plot(abs(eval_sota(i, :) - D(i)))
    xlabel('Iteration')
    ylabel('Error')
    yscale log
    legend('Online', 'Online-reference', 'Direct regression', 'Location', 'best')
    title(['Online prediction of real eigenvalue:', num2str(D(i))])
    box on
end

figure('Position', [100, 100, 1200, 600])
sgtitle('Eigenvalue prediction of reference online algorithm')
timeline = 1: steps-init;
for i = 1:9
    pred = eval_ons(i, :);
    subplot(3,3,i)
    hold on
    plot(abs(pred - D(i)))
    xlabel('Iteration')
    ylabel('Error')
    yscale log
    title(['Online prediction of real eigenvalue:', num2str(D(i))])
    box on
end

figure('Position', [100, 100, 1200, 600])
sgtitle('Eigenvalue prediction of direct regression')
timeline = 1: steps-init;
for i = 1:9
    pred = eval_sota(i, :);
    subplot(3,3,i)
    hold on
    plot(abs(pred - D(i)))
    xlabel('Iteration')
    ylabel('Error')
    yscale log
    title(['Online prediction of real eigenvalue:', num2str(D(i))])
    box on
end

