clear
rng(2024);

% matrix size
n = 100;
dim = n;
% randomly generate eigenvlaues, eigenvectors recover matrix
[A, evals, evecs] = rand_mat_real(n);

% initial state: a certain combination of the eigen-vectors
x0 = evecs * (1:n)';

% lower rank for dmd, and the steps for the simulation snapshots
r = 10; steps = 51;
or_evals = evals(1:r); or_evecs = evecs(:, 1:r);

% simulate snapshots observation
d = zeros([n, steps]);
for i = 1:steps
    d(:, i) = A^(i-1) * x0;
end
X = d(:, 1:end-1); Y = d(:, 2:end);

% direct solution for reference
[U, S, V] = svds(X, r);
A_r = Y * V / S * U';
[rinv_vecs, rinv_vals] = main_eig(A_r, r);
% best solution from data (u-space projection) for reference
A = Y * pinv(X);
[evecs, evals] = main_eig(A, r);
u_vecs = U * U' * evecs; % ideally, u' * evecs is the target of [right]
u_vals = evals;

err_origin = norm(A*evecs - evecs*diag(evals), 'fro');
err_uspace = norm(A*u_vecs - u_vecs*diag(u_vals), 'fro');

% dmd result
[U, S, V] = svds(X, r);
R = U' * Y * V / S;
[right, lambda] = main_eig(R, r);
dmd_vecs = U * right;
dmd_vals = lambda;

err = norm(A*dmd_vecs - dmd_vecs*diag(dmd_vals), 'fro');

iter = 100;
rate = 1;

A_target = A;

right = dmd_vecs;
A_approx = right * diag(lambda) * pinv(right);
[right, lambda] = main_eig(A_approx, r);
[left, ~] = main_eig_left(A_approx, r);

for i = 1:iter
    du = zeros(dim, r);
    dlambda = zeros(r, 1);
    for n = 1:r
        u = right(:, n);
        v = left(:, n);
        term_1 = pinv(lambda(n) * eye(dim) - A_approx) * (eye(dim) - u*v' / (v'*u));
        term_2 = A_target*u - lambda(n)*u;
        du(:, n) = term_1 * term_2;
        dlambda(n) = v' * term_2 ./ (v' * u);
    end

    % update eigens
    right = right + rate*du;
    right = right ./ vecnorm(right);
    lambda = lambda + rate*dlambda;
    % update core matrix
    A_approx = right * diag(lambda) * pinv(right);
    [left, ~] = main_eig_left(A_approx, r);

    % record error
    dmd_vecs = right;
    dmd_vals = lambda;
    err(i+1) = norm(A*dmd_vecs - dmd_vecs*diag(dmd_vals), 'fro');
end

%%% evecs: best from data
%%% u evecs: evecs project to r-rank U and back (our target)
%%% dmd vecs: try to improve dmd vecs
figure()
hold on
yline(err_origin)
yline(err_uspace)
plot(err)
legend('Real eigs', 'Real eigs in U-subspace', 'Correction')



function [Vs, Ds] = sort_by_val(V, D)
    %%% simply sort the [eigenvectors, eigenvalues] by the module of
    %%% eigenvalues
    eigenvalues = abs(diag(D));
    [~, indices] = sort(eigenvalues, 'descend');
    Vs = V(:, indices);
    D = diag(D);
    Ds = diag(D(indices));
end


function [Vs, Ds] = main_eig(A, r)
    %%% simply sort the [eigenvectors, eigenvalues] by the module of
    %%% eigenvalues
    [V, D] = eig(A);
    [Vs, Ds] = sort_by_val(V, D);
    Vs = Vs(:, 1:r);
    Ds = diag(Ds(1:r, 1:r));
end

function [Vs, Ds] = main_eig_left(A, r)
    %%% simply sort the [eigenvectors, eigenvalues] by the module of
    %%% eigenvalues
    A = A';
    [V, D] = eig(A);
    [Vs, Ds] = sort_by_val(V, D);
    Vs = Vs(:, 1:r);
    Ds = diag(Ds(1:r, 1:r));
end

% random matrix with complex eigenvalues and vectors
% (same as the test case of diff-svd)
function A = rand_mat(n)
    mat = normrnd(0, 1, [n, n]);
    [u, ~] = qr(mat);
    
    mat = normrnd(0, 1, [n, n]);
    [v, ~] = qr(mat);
    
    s = logspace(1, -1, n);
    
    A = u * diag(s) * v';
end


% random matrix with real eigenvalues and vectors
function [A, evals, evecs] = rand_mat_real(n)
    evals = logspace(0, -2, n) .* (1 + 0.1*randn(1, n));
    evecs = rand_col(n, n);
    A = evecs * diag(evals) / evecs;
end

function vecs = rand_col(dim, num)
% generate a matrix of column vecters, randomly genereted with directions
% input:
% dim: dimension of the vectors, row of vecs
% num: number of the random vectors. column of vecs
% output:
% vecs: dim*num matrix. each column is a random vector
vecs = unifrnd(0, 2*pi, [dim, num]);
vecs = cos(vecs);
len = vecnorm(vecs, 2, 1);
vecs = vecs ./ len;
end


function compare_eigs(vec1, vec2, val1, val2, name)
    re_vec = norm(real(vec1)-real(vec2), 'fro');
    im_vec = norm(imag(vec1)-imag(vec2), 'fro');
    re_val = norm(real(val1)-real(val2), 'fro');
    im_val = norm(imag(val1)-imag(val2), 'fro');
    fprintf([name, ' vecs error, real = %.6f, imag = %.6f\n'], re_vec, im_vec)
    fprintf([name, ' vals error, real = %.6f, imag = %.6f\n'], re_val, im_val)
    fprintf('=========================================================\n')
end

